        {
          "id": "111c0852-f39a-4f7a-bac7-dbcb88405e6b",
          "name": "Submit now-playing metadata for a station",
          "request": {
            "name": "Submit now-playing metadata for a station",
            "description": {
              "content": "Submits real-time now-playing metadata (current song, artist, album, commercial flag) for a licensed broadcast station to TuneIn. Partners must include their partnerId and partnerKey credentials. Requests should be sent once per song start — duplicate or timer-based submissions within short timeframes may be blocked. Information may take up to 24 hours to appear on TuneIn.com.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "Playing.ashx"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "partnerId",
                  "value": "<string>",
                  "description": "(Required) Unique partner identifier issued by TuneIn upon broadcaster registration.\n"
                },
                {
                  "disabled": false,
                  "key": "partnerKey",
                  "value": "<string>",
                  "description": "(Required) Partner authentication key issued by TuneIn alongside the partnerId.\n"
                },
                {
                  "disabled": false,
                  "key": "id",
                  "value": "<string>",
                  "description": "(Required) Station identifier assigned by TuneIn. Must be prefixed with \"s\" (e.g. s12345).\n"
                },
                {
                  "disabled": false,
                  "key": "title",
                  "value": "<string>",
                  "description": "(Required) Title of the currently playing song."
                },
                {
                  "disabled": false,
                  "key": "artist",
                  "value": "<string>",
                  "description": "(Required) Name of the artist performing the currently playing song."
                },
                {
                  "disabled": false,
                  "key": "album",
                  "value": "<string>",
                  "description": "Album name for the currently playing song."
                },
                {
                  "disabled": false,
                  "key": "commercial",
                  "value": "<boolean>",
                  "description": "Set to true during non-song periods (e.g. advertisements, station IDs). When true, title and artist are not required.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/plain"
              }
            ],
            "method": "GET",
            "auth": null
          },
