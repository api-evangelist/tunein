          "id": "2e91e91c-33ae-4f0f-bf5d-e40c3ffc23fa",
          "name": "Search for stations, shows, and podcasts",
          "request": {
            "name": "Search for stations, shows, and podcasts",
            "description": {
              "content": "Search the TuneIn directory for radio stations, shows, topics, and podcasts. Returns an OPML (XML) or JSON list of matching results. The query parameter must be URL-encoded. Returns a \"No results\" outline element when no matches are found.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search.ashx"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "(Required) Search term. Must be URL-encoded (e.g. \"GitFM\" becomes \"GitFM\", multi-word queries should encode spaces as \"+\").\n"
                },
                {
                  "disabled": false,
                  "key": "render",
                  "value": "<string>",
                  "description": "Response format override. Set to \"json\" to receive JSON instead of the default XML/OPML response.\n"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "c705634a-b2f1-400a-b722-9f656d2563f8",
              "name": "OPML (XML) or JSON list of matching stations/shows. Each result outline may include: type, text, URL, guide_id, image, bitrate, reliability, genre_id, formats, playing, item attributes. When no results are found, returns an outline of type \"text\" with a \"No results for [query]\" message.\n",
              "originalRequest": {
                "url": {
                  "path": [
                    "search.ashx"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "query",
                      "value": "BBC Radio 4"
                    },
